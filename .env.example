DB_URL=jdbc:postgresql://localhost:5432/imobpro
DB_USERNAME=imobpro
DB_PASSWORD=imobpro_dev
SERVER_PORT=8080

# Kotlin API storage and account emails
IMOBPRO_STORAGE_ROOT=./var/imobpro/uploads
APP_PUBLIC_BASE_URL=http://localhost:8080
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Cross-origin frontend origins (comma-separated, exact origins only)
CORS_ALLOWED_ORIGINS=https://seudominio.com

# Compatibility BFF (serve the existing UI through this same-origin gateway)
BFF_PORT=3100
BFF_SESSION_SECRET=replace-with-at-least-32-random-characters
BFF_TRUST_PROXY=false
PUBLIC_ORGANIZATION_SLUG=
LEGACY_WEB_URL=http://host.docker.internal:3000
